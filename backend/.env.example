# Copy this file to backend/.env and replace the placeholders.
# Add credentials only to the ignored backend/.env file.
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@cluster.example.mongodb.net/
DB_USERNAME=
DB_PASSWORD=
MONGO_DATABASE=Users
MEMORY_DATABASE=Memory
MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
PORT=3002
CORS_ORIGIN=http://localhost:3001
GOOGLE_CLIENT_ID=
SESSION_SECRET=replace-with-the-same-secret-as-the-frontend
MEMTY_EMAIL_FROM=Memty Assistant <no-reply@your-domain.example>
MEMORY_VECTOR_INDEX=memory_vector_index
# Optional Python Memory Vault bridge (set both values to enable it in Memty chat).
MEMORY_VAULT_API_URL=http://127.0.0.1:8765
MEMORY_VAULT_API_TOKEN=
