# Copy this file to .env and replace placeholders with real values.
# Add your local Gemini key here. Never commit a populated .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: increase these only within the limits supported by your Gemini plan.
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_MAX_HISTORY_MESSAGES=40

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_OUTPUT_TOKENS=2048
CLAUDE_TIMEOUT_MS=30000

GROK_API_KEY=
GROK_MODEL=grok-3-mini

KIMI_API_KEY=
KIMI_MODEL=kimi-k2-turbo-preview

LLAMA_MODEL=meta-llama/llama-3.3-70b-instruct:free

OPEN_ROUTER_API_KEY=
OPEN_ROUTER_OPEN_API_KEYS=
OPEN_ROUTER_OPEN_AI_MODEL_ID=openai/gpt-4o-mini
OPEN_ROUTER_MODEL_ID=nvidia/nemotron-3.5-lightning:free
OPEN_ROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPEN_ROUTER_MAX_OUTPUT_TOKENS=1024
OPEN_ROUTER_TIMEOUT_MS=9000
OPEN_ROUTER_SITE_URL=http://localhost:3001
OPEN_ROUTER_APP_NAME=Memty

PORT=3001
PROXY_TARGET=http://localhost:3002
CORS_ORIGIN=http://localhost:3001

GOOGLE_CLIENT_ID=

MEMORY_WRITER_MODEL=gemini-2.5-flash
MEMORY_EMBEDDING_MODEL=gemini-embedding-2
MEMORY_VECTOR_INDEX=memory_vector_index
# Shared by the backend and internal Python vault service; replace before Docker use.
MEMORY_VAULT_API_TOKEN=replace-this-with-a-random-secret-at-least-32-characters
# Optional model rates for usage cost estimates (USD per million tokens).
# Example: MEMTY_GEMINI_FLASH_INPUT_USD_PER_MILLION=0.1
